# ============================================================================
# HonestRoom Backend — Environment Variable Template (.env.example)
# Copy this file to .env or export these variables in your environment.
# NEVER commit real credentials to version control.
# ============================================================================

# --- TiDB Cloud Database Configuration ---
# Replace with your actual TiDB Cloud cluster endpoint, port, database, and user credentials.
TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_DATABASE=honestroom
TIDB_USERNAME=your_prefix.root
TIDB_PASSWORD=your_tidb_cloud_password
TIDB_SSL_MODE=VERIFY_IDENTITY

# --- JWT & Security Configuration ---
# Must be at least 32 characters (256 bits) for HMAC-SHA256 signing.
# Generate a strong secret using: openssl rand -base64 48
JWT_SECRET=replace_with_a_strong_256_bit_secret_key_for_honestroom_jwt_signing
JWT_EXPIRATION_MS=86400000
COOKIE_SECURE=false

# --- Application & CORS Configuration ---
FRONTEND_URL=http://localhost:5173
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default
